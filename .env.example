# Environment variables template
# Copy this file to .env and fill in your values

# Mapbox Access Token - Required for map visualization
# Get your token from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# MongoDB Configuration - Used by scripts/exportData.js for data export
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
VITE_MONGODB_URI=your_mongodb_uri_here

# Note: For production, set these variables in Vercel's environment variables section
# Do not commit actual values to version control 