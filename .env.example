# Environment variables template
# Copy this file to .env and fill in your values

# Required variables
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_API_URL=your_api_url_here
VITE_MONGODB_URI=your_mongodb_uri_here

# Note: For production, set these variables in Vercel's environment variables section
# Do not commit actual values to version control

# API URL (development only)
REACT_APP_API_URL=http://localhost:3001/api

# MongoDB connection string
REACT_APP_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Mapbox token for maps
REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here

# Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS SES Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# Security Configuration
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Note: VERCEL_URL is automatically set by Vercel in production
# Only set this in .env.development for local testing
# VERCEL_URL=your-app.vercel.app